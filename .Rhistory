birthweight
#| echo: false
tibble(p = rev(c(0.2, 0.25, 0.3, 0.4, 0.5, 0.6, 0.7, 0.75, 0.8))) |>
mutate(`1 - p` = 1 - p,
odds = p / (1 - p),
odds = round(odds, 3)) |>
mutate(`odds (alternative)` = c("4 to 1", "3 to 1",
"7 to 3", "3 to 2", "1 to 1",
"2 to 3", "3 to 7", "1 to 3",
"1 to 4")) |>
knitr::kable(caption = "probabilities and odds")
