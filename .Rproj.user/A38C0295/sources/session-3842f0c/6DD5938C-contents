#   select(id, trt, age, gender, bmi, epworth1, epworth2)

```

```{r didgeridoo, echo = TRUE}
didgeridoo <- tibble(id = 1:25, 
                     trt = c(1, 2, 1, 2, 1, 2, 1, 1, 2, 2, 2, 2, 1, 1, 1, 
                             2, 2, 2, 1, 1, 2, 2, 1, 2, 2),
                     age = c(45, 41, 41, 39, 33, 55, 50, 65, 43, 59, 53, 
